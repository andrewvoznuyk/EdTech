<div style="font-family: Arial, sans-serif; text-align: center; padding: 30px; background-color: #f9f9f9;">
    <div style="max-width: 500px; margin: 0 auto; background-color: #ffffff; padding: 40px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
        <h2 style="color: #333333; margin-top: 0;">{{ 'template.verification.title'|trans({}, 'email') }}</h2>
        <p style="color: #666666; font-size: 16px; line-height: 1.5;">
            {{ 'template.verification.body'|trans({}, 'email') }}
        </p>

        <div style="margin: 30px 0;">
            <a href="{{ verify_url }}" style="background-color: #ff9900; color: #ffffff; padding: 14px 28px; text-decoration: none; font-weight: bold; border-radius: 4px; display: inline-block; font-size: 16px;">
                {{ 'template.verification.button'|trans({}, 'email') }}
            </a>
        </div>

        <p style="color: #999999; font-size: 12px; margin-bottom: 0;">
            {{ 'template.verification.footer'|trans({}, 'email') }}
        </p>
    </div>
</div>
