<div style="font-family: Arial, sans-serif; text-align: center; padding: 30px; background-color: #f9f9f9;">
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 style="color: #2c3e50;">{{ 'template.password_reset.title'|trans({}, 'email') }}</h2>
    </div>

    <p>{{ 'template.password_reset.greeting'|trans({}, 'email') }}</p>

    <p>{{ 'template.password_reset.body'|trans({}, 'email') }}</p>

    <p>{{ 'template.password_reset.action'|trans({}, 'email') }}</p>

    <div style="text-align: center; margin: 30px 0;">
        <a href="{{ reset_url }}" style="background-color: #3498db; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">
            {{ 'template.password_reset.button'|trans({}, 'email') }}
        </a>
    </div>

    <p>{{ 'template.password_reset.footer'|trans({}, 'email') }}</p>

    <p>{{ 'template.password_reset.ignore'|trans({}, 'email') }}</p>

    <hr style="border: none; border-top: 1px solid #eeeeee; margin: 30px 0;">

    <p style="font-size: 12px; color: #999999; text-align: center;">
        {{ 'template.password_reset.regards'|trans({}, 'email')|raw }}
    </p>
</div>
