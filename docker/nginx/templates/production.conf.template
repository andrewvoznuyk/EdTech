log_format postdata escape=json '$remote_addr "$request" $status BODY="$request_body"';

server {
    listen 80;
    server_name localhost trustua.uk;

    # Logs
    access_log /var/log/nginx/trustua.uk.access.log postdata;
    error_log /var/log/nginx/trustua.uk.error.log;

    client_max_body_size 50M;
    root /var/www/project/api/public;

    location /api {
        proxy_pass http://api:80;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 300;
    }

    location ~* ^/(bundles|_profiler|_wdt|uploads)/.+\.(jpg|jpeg|gif|png|ico|zip|woff2)$ {
        root /var/www/project/api/public;
        expires 30d;
    }

    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        proxy_buffering off;
    }

    # Deny access to other .php files
    location ~ \.php$ {
        return 404;
    }
}
