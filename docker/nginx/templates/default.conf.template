server {
    listen 80;
    server_name ${NGINX_HOST};

    access_log  /var/log/nginx/80-access.log  main;
    access_log /var/log/nginx/80-${NGINX_HOST}.access.log;
    error_log /var/log/nginx/80-${NGINX_HOST}.error.log;

    return 301 https://${NGINX_HOST};
}

server {
    listen ${NGINX_PORT} ssl http2;
    server_name ${NGINX_HOST};

    ssl_certificate /etc/nginx/certs/${NGINX_CERT_CRT};
    ssl_certificate_key /etc/nginx/certs/${NGINX_CERT_KEY};
    client_max_body_size 50M;

    root /var/www/project/api/public;

    fastcgi_read_timeout 300;
    proxy_read_timeout 300;

    access_log  /var/log/nginx/access.log  main;
    access_log /var/log/nginx/${NGINX_HOST}.access.log;
    error_log /var/log/nginx/${NGINX_HOST}.error.log;

    location /api {
            fastcgi_pass api:9000;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /var/www/api/public/index.php;
            fastcgi_param DOCUMENT_ROOT /var/www/api/public;
            fastcgi_param REQUEST_URI $request_uri;

            fastcgi_read_timeout 300;
    }

    location ^~ /api/bundles/ {
            alias /var/www/project/api/public/bundles/;
            expires max;
            log_not_found off;
    }

    location / {
        proxy_pass http://frontend:5173;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $http_host;  # ← Изменить на $http_host
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}

server {
    listen 8443 ssl;
    server_name ${NGINX_HOST};

    ssl_certificate /etc/nginx/certs/${NGINX_CERT_CRT};
    ssl_certificate_key /etc/nginx/certs/${NGINX_CERT_KEY};

    access_log  /var/log/nginx/access.log  main;
    access_log /var/log/nginx/${NGINX_HOST}-phpmyadmin.access.log main;
    error_log /var/log/nginx/${NGINX_HOST}-phpmyadmin.error.log;

    location / {
        proxy_pass http://phpmyadmin:80;
    }
}